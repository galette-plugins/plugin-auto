{% extends 'elements/list.html.twig' %}

{% set nb = autos|length %}
{% set is_public = not login.isLogged() %}

{% set form = {
    'route': {
        'name': 'publicVehiclesList'
    }
} %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%count vehicle", "%count vehicles", count_vehicles, 'auto')|replace({"%count": count_vehicles}),
    } %}
    {{ parent() }}
{% endblock %}

{% block header %}
    {% set no_action = true %}
    {% set columns = [
        {'label': _T("Picture"), 'collapse': true},
        {'label': _T("Name", "auto")},
        {'label': _T("Owner", "auto")},
        {'label': _T("Brand", "auto")},
        {'label': _T("Model", "auto")},
        {'label': _T("Description", "auto")},
    ] %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% for auto in autos %}
        {% set brand = auto.model.brand %}

        <tr>
            <td class="collapsing" data-col-label="{{ _T("Picture") }}">
                {# a thumbnail: the picture scaled down to 80 pixels wide at most #}
                {% set photo_width = auto.picture.getOptimalWidth() %}
                {% set thumb_width = min(photo_width, 80) %}
                <img
                    src="{{ url_for("vehiclePhoto", {"id": auto.id}) }}"
                    class="ui image"
                    width="{{ thumb_width }}"
                    height="{{ photo_width > 0 ? (auto.picture.getOptimalHeight() * thumb_width / photo_width)|round : thumb_width }}"
                    loading="lazy"
                    alt="{{ auto.name }}"
                />
            </td>
            <td data-col-label="{{ _T("Name", "auto") }}">
                {{ auto.name }}
                {% if history_allowed[auto.id] %}
                    <button type="button" class="ui mini basic icon button vehicle-history" data-url="{{ url_for("vehicleHistory", {"id": auto.id}) }}" title="{{ _T("Show full car state history", "auto") }}">
                        <i class="ui history icon" aria-hidden="true"></i>
                        <span class="visually-hidden">{{ _T("Car state history", "auto") }}</span>
                    </button>
                {% endif %}
            </td>
            {# members kept out of the members list are not named #}
            <td data-col-label="{{ _T("Owner", "auto") }}">{{ public_owners[auto.id] ? auto.owner.sfullname : '—' }}</td>
            <td data-col-label="{{ _T("Brand", "auto") }}">{{ brand.value }}</td>
            <td data-col-label="{{ _T("Model", "auto") }}">{{ auto.model.model }}</td>
            <td data-col-label="{{ _T("Description", "auto") }}">
                {# what the car is, then how it is built #}
                {% set identity = [auto.getFirstCirculationYear(), auto.body.value, auto.finition.value]|filter(v => v) %}
                {% set specs = [] %}
                {% if auto.engine_size %}
                    {% set specs = specs|merge([_T("%1$s cc", "auto")|replace({'%1$s': auto.engine_size|format_number({}, 'decimal', 'default', i18n.getWebID())})]) %}
                {% endif %}
                {% if auto.horsepower %}
                    {% set specs = specs|merge([_T("%1$s hp", "auto")|replace({'%1$s': auto.horsepower|format_number({}, 'decimal', 'default', i18n.getWebID())})]) %}
                {% endif %}
                {% set specs = specs|merge([auto.getFuelLabel(), auto.transmission.value, auto.color.value]|filter(v => v)) %}
                {% if identity|length > 0 %}
                    <strong>{{ identity|join(' · ') }}</strong>
                {% endif %}
                {% if specs|length > 0 %}
                    <div class="ui small grey text">{{ specs|join(' · ') }}</div>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="emptylist">{{ _T("No car in the database", "auto") }}</td></tr>
    {% endfor %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        $(function() {
            $('.vehicle-history').on('click', function() {
                $.ajax({
                    url: $(this).data('url'),
                    success: function(res) {
                        $('body').modal({
                            title: '{{ _T("Car's history", "auto")|e('js') }}',
                            content: res,
                            class: 'large'
                        }).modal('show');
                    },
                    error: function() {
                        {% include "elements/js/modal.js.twig" with {
                            modal_title_twig: _T("An error occurred displaying history :(", "auto")|e("js"),
                            modal_without_content: true,
                            modal_class: "mini",
                            modal_deny_only: true,
                            modal_cancel_text: _T("Close")|e("js"),
                            modal_classname: "redalert",
                        } %}
                    }
                });
            });
        });
    </script>
{% endblock %}

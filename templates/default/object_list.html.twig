{% extends 'elements/list.html.twig' %}
{% import "macros.twig" as macros %}

{% set field = obj.getField() %}

{% set nb = list|length %}

{% set columns = [
    {'label': field_name}
] %}

{% block infoline %}
    {% set infoline = {
        'label': count_label,
        'route': {
            'name': 'propertyFilter',
            'args': {'property': field}
        }
    } %}
    {{ parent() }}
{% endblock %}

{% block infoline_actions %}
    <a
        class="ui tiny labeled icon button"
        href="{{ url_for("propertyAdd", {"property": obj.getRouteName()}) }}"
    >
        <i class="plus circle green icon" aria-hidden="true"></i>
        {{ add_text }}
    </a>
{% endblock %}

{% block body %}
    {% for o in list %}
        {% set edit_link = url_for("propertyEdit", {"property": obj.getRouteName(), "id": o.getId()}) %}
    <tr>
        <td data-col-label="{{ field_name }}">
            <a
                href="{% if obj.hasDetails() %}{{ url_for("propertyShow", {"property": obj.getRouteName(), "id": o.getId()}) }}{% else %}{{ edit_link }}{% endif %}"
            >
                {{ o.getValue() }}
            </a>
        </td>
        <td class="center actions_row collapsing">
            {{ macros.drawListAction(_T("Edit %property", "auto")|replace({"%property": o.getValue()}), {'name': 'propertyEdit', 'args': {'property': obj.getRouteName(), 'id': o.getId()}}, 'edit') }}
            {{ macros.drawListAction(_T("%property: remove from database", "auto")|replace({"%property": o.getValue()}), {'name': 'removeProperty', 'args': {'property': obj.getRouteName(), 'id': o.getId()}}, 'red trash', 'delete') }}
        </td>
    </tr>
    {% else %}
        <tr><td colspan="{{ columns_count }}" class="emptylist">{{ _T("no record found", "auto") }}</td></tr>
    {% endfor %}
{% endblock %}

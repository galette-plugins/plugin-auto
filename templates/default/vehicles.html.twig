{% extends 'page.html.twig' %}

{% set can_change_owner = login.isAdmin() or login.isStaff() or login.isGroupManager() %}

{% block content %}
    {% if mode == 'new' %}
        {% set action = url_for("doVehicleAdd") %}
    {% else %}
        {% set action = url_for("doVehicleEdit", {"id": car.getId()}) %}
    {% endif %}
    <form
        class="ui form"
        action="{{ action }}"
        method="post"
        id="modifform"
        enctype="multipart/form-data"
        data-models-url="{{ url_for("ajaxModels") }}"
        data-models-placeholder="{{ _T("Choose a model", "auto") }}"
    >
        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Car's base informations", "auto") }}
            </div>
            <div class="active content">
                {% include "components/forms/text.html.twig" with {
                    id: 'name',
                    value: car.getName(),
                    label: _T("Name", "auto"),
                    required: required.name is defined
                } %}

                {% set brand_list_values = {(-1): _T("Choose a brand", "auto")} %}
                {% for brand in brands %}
                    {% set brand_list_values = brand_list_values + {(brand.getId()): brand.getValue()} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'brand',
                    value: car.getModel().brand.getId(),
                    values: brand_list_values,
                    label: _T("Brand", "auto"),
                    required: required.brand is defined
                } %}

                {% set model_list_values = {'-1': _T("Choose a model", "auto")} %}
                {% for model in models %}
                    {% set model_list_values = model_list_values + {(model.id): model.model} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'model',
                    value: car.getModel().getId(),
                    values: model_list_values,
                    label: _T("Model", "auto"),
                    required: required.model is defined
                } %}

                {% include "components/forms/date.html.twig" with {
                    id: 'first_registration_date',
                    value: car.getFirstRegistrationDate() ? car.getFirstRegistrationDate()|date(_T("Y-m-d")) : '',
                    label: _T("First registration date", "auto"),
                    title: _T("First registration date", "auto")
                } %}

                {% include "components/forms/date.html.twig" with {
                    id: 'first_circulation_date',
                    value: car.getFirstCirculationDate() ? car.getFirstCirculationDate()|date(_T("Y-m-d")) : '',
                    label: _T("First circulation date", "auto"),
                    title: _T("First circulation date", "auto")
                } %}

                {% include "components/forms/number.html.twig" with {
                    id: 'mileage',
                    value: car.getMileage(),
                    label: _T("Mileage", "auto"),
                    required: required.mileage is defined
                } %}

                {% include "components/forms/number.html.twig" with {
                    id: 'seats',
                    value: car.getSeats(),
                    label: _T("Seats", "auto"),
                    required: required.seats is defined
                } %}

            </div>
        </div>

        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Car's photo", "auto") }}
            </div>
            <div class="active content">
                <img src="{% if car.getId() %}{{ url_for("vehiclePhoto", {"id": car.getId()}) }}{% else %}{{ url_for("vehiclePhoto") }}{% endif %}" class="picture" width="{{ car.picture.getOptimalWidth() }}" height="{{ car.picture.getOptimalHeight() }}" alt="{{ _T("Car's photo", "auto") }}"/><br/>
                {% if car.hasPicture() %}
                    {% include "components/forms/checkbox.html.twig" with {
                        id: 'del_photo',
                        value: 1,
                        label: _T("Delete image"),
                        required: false
                    } %}
                {% endif %}
                <div class="ui file action input">
                    <input id="photo_file" type="file" name="photo"/>
                    <label for="photo_file" class="ui button">
                        <i class="blue upload icon" aria-hidden="true"></i>
                        {% if car.hasPicture() %}{{ _T("Choose another file") }}{% else %}{{ _T("Choose a file") }}{% endif %}
                    </label>
                </div>
            </div>
        </div>

        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Current car's state informations", "auto") }}
            </div>
            <div class="active content">
                {% if car.getId() %}
                    <div class="field">
                        <label>{{ _T("Current owner", "auto") }}</label>
                        <p>
                            {{ car.getOwner().sfullname }}
                            <button type="button" class="ui mini basic icon button vehicle-history" data-url="{{ url_for("vehicleHistory", {"id": car.getId()}) }}" title="{{ _T("Show full car state history", "auto") }}">
                                <i class="ui history icon" aria-hidden="true"></i>
                                <span class="visually-hidden">{{ _T("Car state history", "auto") }}</span>
                            </button>
                        </p>
                        {% if can_change_owner %}
                            <div id="change_owner-checkbox" class="ui toggle checkbox">
                                <input type="checkbox" name="change_owner" id="change_owner" value="1"/>
                                <label for="change_owner"><i class="linkify icon" aria-hidden="true"></i> {{ _T("Change car's owner", "auto") }}</label>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <input type="hidden" name="change_owner" value="1"/>
                {% endif %}

                {% if can_change_owner %}
                    {% include 'components/forms/member_dropdown.html.twig' with {
                        'required': true,
                        'component_id': 'owner_id_elt',
                        'id': 'owner_id',
                        'label': _T("Owner", "auto"),
                        'value': car.getOwnerId(),
                        'component_class': car.getId() ? 'field displaynone' : 'field'
                    } %}
                {% elseif not car.getId() %}
                    {# simple members only own their vehicles #}
                    <div class="field">
                        <label>{{ _T("Owner", "auto") }}</label>
                        <p>{{ login.loggedInAs(true) }}</p>
                    </div>
                {% endif %}

                {% set color_list_values = {(-1): _T("Choose a color", "auto")} %}
                {% for color in colors %}
                    {% set color_list_values = color_list_values + {(color.getId()): color.getValue()} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'color',
                    value: car.getColor().getId(),
                    values: color_list_values,
                    label: _T("Color", "auto"),
                    required: required.color is defined
                } %}

                {% set state_list_values = {(-1): _T("Choose a state", "auto")} %}
                {% for state in states %}
                    {% set state_list_values = state_list_values + {(state.getId()): state.getValue()} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'state',
                    value: car.getState().getId(),
                    values: state_list_values,
                    label: _T("State", "auto"),
                    required: required.state is defined
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'registration',
                    value: car.getRegistration(),
                    label: _T("Registration number", "auto"),
                    required: required.registration is defined
                } %}

            </div>
        </div>

        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Car's technical informations", "auto") }}
            </div>
            <div class="active content">
                {% set body_list_values = {(-1): _T("Choose a body", "auto")} %}
                {% for body in bodies %}
                    {% set body_list_values = body_list_values + {(body.getId()): body.getValue()} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'body',
                    value: car.getBody().getId(),
                    values: body_list_values,
                    label: _T("Body", "auto"),
                    required: required.body is defined
                } %}

                {% set transmission_list_values = {(-1): _T("Choose a transmission", "auto")} %}
                {% for transmission in transmissions %}
                    {% set transmission_list_values = transmission_list_values + {(transmission.getId()): transmission.getValue()} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'transmission',
                    value: car.getTransmission().getId(),
                    values: transmission_list_values,
                    label: _T("Transmission", "auto"),
                    required: required.transmission is defined
                } %}

                {% set finition_list_values = {(-1): _T("Choose a finition", "auto")} %}
                {% for finition in finitions %}
                    {% set finition_list_values = finition_list_values + {(finition.getId()): finition.getValue()} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'finition',
                    value: car.getFinition().getId(),
                    values: finition_list_values,
                    label: _T("Finition", "auto"),
                    required: required.finition is defined
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'chassis_number',
                    value: car.getChassisNumber(),
                    label: _T("Chassis number", "auto"),
                    required: required.chassis_number is defined
                } %}

                {% include "components/forms/number.html.twig" with {
                    id: 'horsepower',
                    value: car.getHorsepower(),
                    label: _T("Horsepower", "auto"),
                    required: required.horsepower is defined
                } %}

                {% include "components/forms/number.html.twig" with {
                    id: 'engine_size',
                    value: car.getEngineSize(),
                    label: _T("Engine size", "auto"),
                    required: required.engine_size is defined
                } %}

                {% set fuel_list_values = {(-1): _T("Choose a fuel", "auto")} %}
                {% for k, fuel in fuels %}
                    {% set fuel_list_values = fuel_list_values + {(k): fuel} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'fuel',
                    value: car.getFuel(),
                    values: fuel_list_values,
                    label: _T("Fuel", "auto"),
                    required: required.fuel is defined
                } %}
            </div>
        </div>

        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Comment", "auto") }}
            </div>
            <div class="active content">
                {% include "components/forms/textarea.html.twig" with {
                    id: 'comment',
                    value: car.getComment(),
                    label: _T("Comment", "auto"),
                    required: required.comment is defined
                } %}
            </div>
        </div>

        <div class="ui basic center aligned fitted segment">
            <button type="submit" name="valid" class="action ui labeled icon primary button">
                <i class="save icon" aria-hidden="true"></i> {{ _T("Save") }}
            </button>
            <input type="hidden" name="{{ mode }}" value="1"/>
            <input type="hidden" name="id_car" value="{{ car.getId() }}"/>
        </div>
    </form>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
    {% if can_change_owner %}
        {% include "elements/js/choose_adh.js.twig" with {"js_chosen_id": "#owner_id"} %}
    {% endif %}
    {% if car.getId() %}
        {% include "@PluginGaletteAuto/history_modal.js.twig" %}
    {% endif %}
    </script>
{% endblock %}

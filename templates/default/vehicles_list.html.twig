{% extends 'elements/list.html.twig' %}
{% import "macros.twig" as macros %}

{% set nb = autos|length %}

{% set columns = [
    {'label': _T("ID"), 'collapse': true},
    {'label': _T("Name", "auto"), 'order': constant('GaletteAuto\\Filters\\AutosList::ORDERBY_NAME')},
    {'label': _T("Owner", "auto"), 'order': constant('GaletteAuto\\Filters\\AutosList::ORDERBY_OWNER')},
    {'label': _T("Brand", "auto"), 'order': constant('GaletteAuto\\Filters\\AutosList::ORDERBY_BRAND')},
    {'label': _T("Model", "auto"), 'order': constant('GaletteAuto\\Filters\\AutosList::ORDERBY_MODEL')},
] %}

{% set form = {
    'route': {
        'name': 'vehiclesList'
    },
    'order': {
        'name': cur_route,
        'args': cur_route == 'memberVehiclesList' ? {'id': id_adh} : []
    }
} %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%count vehicle", "%count vehicles", count_vehicles, 'auto')|replace({"%count": count_vehicles}),
        'route': {
            'name': 'vehiclesFilter',
            'args': []
        }
    } %}
    {{ parent() }}
{% endblock %}

{% block infoline_actions %}
    <a
            class="ui tiny labeled icon button"
            href="{{ url_for("vehicleAdd") }}"
    >
        <i class="plus circle green icon" aria-hidden="true"></i>
        {{ _T("Add new vehicle", "auto") }}
    </a>
{% endblock %}

{% block body %}
    {% for auto in autos %}
        {% set brand = auto.getModel().getBrand() %}
        {% set edit_link = url_for("vehicleEdit", {"id": auto.getId()}) %}

        <tr>
            <td class="collapsing" data-scope="row">
                <span class="ui checkbox">
                    <input type="checkbox" name="entries_sel[]" id="entry_sel_{{ auto.getId() }}" value="{{ auto.getId() }}"/>
                    <label for="entry_sel_{{ auto.getId() }}">{{ auto.getId() }}</label>
                </span>
            </td>
            <td data-col-label="{{ _T("Name", "auto") }}"><a href="{{ edit_link }}">{{ auto.getName() }}</a></td>
            <td data-col-label="{{ _T("Owner", "auto") }}"><a href="{{ url_for("member", {"id": auto.getOwnerId()}) }}">{{ auto.getOwner().sfullname }}</a></td>
            <td data-col-label="{{ _T("Brand", "auto") }}"><a href="{{ edit_link }}">{{ brand.getValue() }}</a></td>
            <td data-col-label="{{ _T("Model", "auto") }}"><a href="{{ edit_link }}">{{ auto.getModel().getModel() }}</a></td>
            <td class="center actions_row collapsing">
                {% if login.isAdmin() or login.isStaff() or auto.getOwnerId() == login.id or login.isGroupManager() and preferences.pref_bool_groupsmanagers_edit_member %}
                    {% set actions = [
                        {
                            'label': _T("Edit %vehicle", "auto")|replace({"%vehicle": auto.getName()}),
                            'route': {
                                'name': 'vehicleEdit',
                                'args': {'id': auto.getId()}
                            },
                            'icon': 'edit'
                        },
                        {
                            'label': _T("%vehiclename: remove from database", "auto")|replace({"%vehiclename": auto.getName()}),
                            'route': {
                                'name': 'removeVehicle',
                                'args': {'id': auto.getId()},
                            },
                            'icon': 'red trash',
                            'extra_class': 'delete'
                        }
                    ] %}

                    {% for action in actions %}
                        {{ macros.drawListAction(action.label, action.route, action.icon, action.extra_class|default('')) }}
                    {% endfor %}
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="{{ columns_count }}" class="emptylist">{% if show_mine == 1 %}{{ _T("No car has been registered yet for your account.", "auto") }}{% else %}{{ _T("No car in the database", "auto") }}{% endif %}</td></tr>
    {% endfor %}
{% endblock %}

{% block extra_form %}
    {% if id_adh is defined %}
        <input type="hidden" name="id_adh" value="{{ id_adh }}"/>
    {% endif %}
{% endblock %}

{% if nb > 0 %}
    {% if login.isAdmin() or login.isStaff() %}
        {% set batch = {
            'route': {
                'name': 'batch-vehicleslist'
            },
            'modal': {
                'title': _T("No vehicle selected", "auto"),
                'content': _T("Please make sure to select at least one vehicle from the list to perform this action.", "auto")
            }
        } %}
        {% set batch_actions = [
            {
                'name': 'delete',
                'label': _T("Delete"),
                'icon': 'red trash'
            }
        ] %}
    {% endif %}
{% endif %}

{% extends 'page.html.twig' %}

{% block content %}
    {% set pk = obj.getPk() %}
    {% set field = obj.getField() %}

    <form class="ui form" action="{% if mode == "new" %}{{ url_for("doPropertyAdd", {"property": set}) }}{% else %}{{ url_for("doPropertyEdit", {"property": set, "id": obj.getId()}) }}{% endif %}" method="post" id="modifform">
        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ page_title }}
            </div>
            <div class="active content">
                {% include "components/forms/text.html.twig" with {
                    id: field,
                    name: field,
                    value: obj.getValue(),
                    label: obj.getFieldLabel(),
                    required: true,
                    autofocus: true
                } %}
            </div>
        </div>

        {% if fields_labels is defined %}
        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Vehicle fields", "auto") }}
            </div>
            <div class="active content">
                <p>{{ _T("Choose which fields vehicles of this type use; brand and model are always required.", "auto") }}</p>
                {% for field, label in fields_labels %}
                    {% include "components/forms/select.html.twig" with {
                        id: 'fields_' ~ field,
                        name: 'fields[' ~ field ~ ']',
                        value: obj.getFieldMode(field),
                        values: fields_modes,
                        label: label|capitalize
                    } %}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="ui basic center aligned fitted segment">
            <button type="submit" name="valid" class="action ui labeled icon primary button">
                <i class="save icon" aria-hidden="true"></i> {{ _T("Save") }}
            </button>
            <input type="hidden" name="set" value="{{ set }}"/>
            <input type="hidden" name="{{ mode }}" value="1"/>
            <input type="hidden" name="{{ pk }}" value="{{ obj.getId() }}"/>
        </div>
    </form>
{% endblock %}

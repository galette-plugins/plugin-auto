{% extends 'elements/list.html.twig' %}
{% import "macros.twig" as macros %}

{% set nb = count_models %}

{% set form = {
    'route': {
        'name': 'modelsFilter'
    },
    'order': {
        'name': 'modelsList'
    }
} %}

{% set columns = [
    {'label': _T("Model", "auto"), 'order': constant('GaletteAuto\\Filters\\ModelsList::ORDERBY_MODEL')},
    {'label': _T("Brand", "auto"), 'order': constant('GaletteAuto\\Filters\\ModelsList::ORDERBY_BRAND')}
] %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%count model", "%count models", count_models, "auto")|replace({"%count": count_models}),
        'route': {
            'name': 'modelsFilter'
        }
    } %}
    {{ parent() }}
{% endblock %}

{% block infoline_actions %}
    <a
        class="ui tiny labeled icon button"
        href="{{ url_for("modelAdd") }}"
    >
        <i class="plus circle green icon" aria-hidden="true"></i>
        {{ _T("Add new model", "auto") }}
    </a>
{% endblock %}

{% block body %}
    {% for m in models %}
        {% set edit_link = url_for("modelEdit", {"id": m.id}) %}
    <tr>
        <td data-col-label="{{ _T("Model", "auto") }}"><a href="{{ edit_link }}">{{ m.model }}</a></td>
        <td data-col-label="{{ _T("Brand", "auto") }}"><a href="{{ edit_link }}">{{ m.brand.getValue() }}</a></td>
        <td class="center actions_row collapsing">
            {% set label = m.brand.getValue() ~ ' ' ~ m.model %}
            {{ macros.drawListAction(_T("Edit %property", "auto")|replace({"%property": label}), {'name': 'modelEdit', 'args': {'id': m.id}}, 'edit') }}
            {{ macros.drawListAction(_T("%property: remove from database", "auto")|replace({"%property": label}), {'name': 'removeModel', 'args': {'id': m.id}}, 'red trash', 'delete') }}
        </td>
    </tr>
    {% else %}
        <tr><td colspan="{{ columns_count }}" class="emptylist">{{ _T("no record found", "auto") }}</td></tr>
    {% endfor %}
{% endblock %}
